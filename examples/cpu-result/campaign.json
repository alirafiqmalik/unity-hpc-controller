{
  "schema_version": 1,
  "campaign_id": "cpu-result-example",
  "bundle": {"path": "examples/cpu-result"},
  "max_concurrent": 1,
  "max_attempts": 2,
  "tasks": [
    {
      "task_id": "summarize",
      "argv": ["python3", "task.py"],
      "resources": {
        "gpu_count": 0,
        "cpus": 1,
        "memory_mb": 1024,
        "walltime_seconds": 300
      },
      "outputs": ["result.json"]
    }
  ]
}
