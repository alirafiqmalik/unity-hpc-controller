        "verticalAlign": "middle",
        "growY": 0,
        "url": "",
        "scale": 1,
        "richText": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "RELEASE GATES"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Four variants retain both caps. Failed smoke gate pauses only dependents. Uncertain submission never duplicates work."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Partial retrieval preserves files. Old reports remain stable. Scheduler mutation and maintenance races fail closed."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Site and adapter spikes have explicit fallbacks. Recurrence, auto-recovery, browser editing, and arbitrary formulas remain deferred."
                }
              ]
            }
          ]
        }
      }
    },
