            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "“Schedule reassign” is interpreted through these three intents. Automatic queue migration is deferred."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Resource mutation, cancellation, and recovery each need their own reviewed scope."
                }
              ]
            }
          ]
        }
      }
    },
