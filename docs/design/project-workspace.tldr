              "content": [
                {
                  "type": "text",
                  "text": "Keep variants distinct in aggregation."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Create analysis revisions over saved data."
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Exit: reports retain provenance; tests"
                }
              ]
            },
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "stay outside research aggregates."
                }
              ]
            }
