#!/usr/bin/env python3
"""
hpc-usage — view cluster usage history as plots IN THE TERMINAL (over SSH, no
display needed) using plotext. Reads the hourly_resource table of the shared
summaries.db (built by hpc-sync-telemetry + rollup.py).

  hpc-usage --gpu h100 --last 7d --plot util
  hpc-usage --compare h100,a100,l40s --plot util
  hpc-usage --plot heatmap
  hpc-usage --partition gpu --last 24h --plot samples

Falls back to a message if plotext/data are missing.
"""

import argparse
import os
import sqlite3
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path


def data_dir() -> Path:
    """Machine-wide cluster-intel data root (shared, version-independent).
    Override with $UNITY_HPC_DATA; default ~/.local/share/unity-hpc."""
    d = os.environ.get("UNITY_HPC_DATA")
    if d:
        return Path(d).expanduser()
    xdg = os.environ.get("XDG_DATA_HOME")
    base = Path(xdg).expanduser() if xdg else Path.home() / ".local" / "share"
    return base / "unity-hpc"

try:
    import pandas as pd
except ImportError:
    sys.exit("Missing deps. Run: pip install pandas plotext")
try:
    import plotext as plt
except ImportError:
    sys.exit("Missing plotext. Run: pip install plotext")

DEFAULT_DB = data_dir() / "summaries.db"

METRICS = {
    "util": ("util_mean", "mean utilization"),
    "peak": ("util_max", "peak utilization"),
    "free": ("free_ratio", "free ratio"),
    "samples": ("samples", "samples"),
}


def parse_last(s: str | None) -> timedelta | None:
    if not s:
        return None
    unit = s[-1].lower()
    mult = {"h": 1 / 24, "d": 1, "w": 7}.get(unit)
    if mult is None:
        sys.exit("--last must end in h, d, or w (e.g. 24h, 7d, 2w)")
    return timedelta(days=float(s[:-1]) * mult)


def load(db: Path, gpu, partition, last) -> pd.DataFrame:
    if not db.exists():
        sys.exit(f"No usage data at {db}\n"
                  "Run hpc-sync-telemetry to pull cluster telemetry and build summaries.db.")
    con = sqlite3.connect(db)
    con.row_factory = sqlite3.Row
    try:
        rows = con.execute(
            "SELECT resource_kind, resource_id, hour_utc, util_min, util_mean, "
            "util_max, util_p95, free_ratio, samples FROM hourly_resource"
        ).fetchall()
    finally:
        con.close()
    df = pd.DataFrame([dict(r) for r in rows])
    if df.empty:
        return df
    df["slot"] = pd.to_datetime(df["hour_utc"], utc=True)
    if gpu:
        df = df[(df["resource_kind"] == "gpu_type") & (df["resource_id"] == gpu)]
    if partition:
        df = df[(df["resource_kind"] == "partition") & (df["resource_id"] == partition)]
    if last:
        df = df[df["slot"] >= datetime.now(timezone.utc) - last]
    return df


def timeseries(df, col):
    return df.groupby("slot")[col].mean().sort_index()


def plot_line(df, metric, gpu, partition):
    col, label = METRICS[metric]
    s = timeseries(df, col)
    if s.empty:
        sys.exit("No data for that selection.")
    plt.clf()
    plt.date_form("Y-m-d H:M")
    plt.plot(s.index.strftime("%Y-%m-%d %H:%M").tolist(), s.values.tolist())
    scope = " · ".join(filter(None, [f"gpu={gpu}" if gpu else "", f"part={partition}" if partition else ""]))
    plt.title(f"Unity {label}{(' — ' + scope) if scope else ''}")
    plt.xlabel("UTC"); plt.ylabel(label)
    plt.show()


def plot_compare(df, metric, gpus):
    col, label = METRICS[metric]
    plt.clf(); plt.date_form("Y-m-d H:M")
    any_data = False
    for g in gpus:
        s = timeseries(df[(df["resource_kind"] == "gpu_type") & (df["resource_id"] == g)], col)
        if not s.empty:
            any_data = True
            plt.plot(s.index.strftime("%Y-%m-%d %H:%M").tolist(), s.values.tolist(), label=g)
    if not any_data:
        sys.exit("No data for the requested GPU types.")
    plt.title(f"Unity {label} — backend comparison")
    plt.xlabel("UTC"); plt.ylabel(label)
    plt.show()


def plot_heatmap(df, metric):
    col, label = METRICS[metric]
    per_slot = df.groupby("slot")[col].mean().reset_index()
    per_slot["hour"] = per_slot["slot"].dt.hour
    by_hour = per_slot.groupby("hour")[col].mean().reindex(range(24), fill_value=0)
    plt.clf()
    plt.bar([f"{h:02d}" for h in range(24)], by_hour.values.tolist())
    plt.title(f"Unity avg {label} by hour of day (UTC)")
    plt.xlabel("hour UTC"); plt.ylabel(f"avg {label}")
    plt.show()


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--db", default=str(DEFAULT_DB))
    ap.add_argument("--gpu", default=None, help="Filter to one GPU type")
    ap.add_argument("--partition", default=None)
    ap.add_argument("--last", default=None, help="Window, e.g. 24h, 7d, 2w")
    ap.add_argument("--compare", default=None, help="Comma-separated GPU types to overlay")
    ap.add_argument("--metric", default="util", choices=list(METRICS))
    ap.add_argument("--plot", default="line", choices=["line", "compare", "heatmap", "util", "samples"])
    args = ap.parse_args()

    # allow --plot util/samples as metric shortcuts
    if args.plot in ("util", "samples"):
        args.metric, args.plot = args.plot, "line"

    df = load(Path(args.db), args.gpu, args.partition, parse_last(args.last))
    if df.empty:
        sys.exit("No usage rows match that selection.")

    if args.compare:
        plot_compare(df, args.metric, [g.strip() for g in args.compare.split(",")])
    elif args.plot == "heatmap":
        plot_heatmap(df, args.metric)
    else:
        plot_line(df, args.metric, args.gpu, args.partition)


if __name__ == "__main__":
    main()
