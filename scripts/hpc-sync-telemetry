#!/usr/bin/env bash
# hpc-sync-telemetry — entry point for the local-archive telemetry pull.
# The controller passes UNITY_TELEMETRY_SRC from its saved settings or its
# environment. The synchronizer requires that value, so a blank source fails
# safely before any transfer.
set -euo pipefail

exec bash "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/cluster-intel/sync-telemetry.sh" "$@"
