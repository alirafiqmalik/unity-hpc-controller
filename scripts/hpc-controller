#!/usr/bin/env bash
# hpc-controller — start the headless Unity HPC controller API.
#
# Usage:
#   hpc-controller                      background, loopback only (default)
#   hpc-controller --status             pid and URLs
#   hpc-controller --stop               stop the background process
#   hpc-controller --fg                 stay in the terminal
#   hpc-controller --tailscale          also publish over `tailscale serve`
#   hpc-controller --port 9000          pick a port
#   hpc-controller --install-user-service   write a systemd --user unit and exit
#   hpc-controller --service-name NAME     select an isolated user unit
#
# The API has no browser page. Do not use `tailscale funnel`: it publishes the
# API to the internet.
#
# Always-on across reboot:
#   hpc-controller --install-user-service
#   systemctl --user enable --now unity-hpc-controller
set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="${PLUGIN_DIR}${PYTHONPATH:+:$PYTHONPATH}"

exec python3 -m controller.serve "$@"
