#!/usr/bin/env python3
"""Remove cluster telemetry days that are already archived locally (I8).

The local tree is the archive. After a successful pull and rollup, days that
are present locally, fully summarised, and not today may leave the cluster.
UNITY_HPC_FORCE_PRUNE=1 skips the summarised check. Today's live day never
goes. A day that is not on this machine never goes.
"""

import os
import sys
import argparse
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib import retention  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Drop archived telemetry days from the cluster staging tree.",
        epilog="Set UNITY_HPC_FORCE_PRUNE=1 to skip the fully-summarised check.",
    )
    parser.add_argument(
        "source",
        help="The same UNITY_TELEMETRY_SRC the pull used (host:/path or local).",
    )
    args = parser.parse_args()
    force = os.environ.get("UNITY_HPC_FORCE_PRUNE") == "1"
    try:
        result = retention.prune_source(args.source, force=force)
    except ValueError as exc:
        print(f"hpc-remote-prune: {exc}", file=sys.stderr)
        return 2
    for warning in result.get("warnings") or []:
        print(f"hpc-remote-prune: {warning}", file=sys.stderr)
    dropped = result.get("dropped") or []
    if dropped:
        print("hpc-remote-prune: dropped " + ", ".join(dropped))
    else:
        print("hpc-remote-prune: nothing to drop")
    if result.get("ok", True):
        return 0
    print(f"hpc-remote-prune: {result.get('error') or 'drop failed'}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
