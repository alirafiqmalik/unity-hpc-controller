#!/usr/bin/env python3
"""Compare two rows in a project's header-driven results.tsv."""

from __future__ import annotations

import csv
import json
import os
import subprocess
import sys
from pathlib import Path


def _metrics(project: Path) -> tuple[str | None, str]:
    try:
        data = json.loads((project / "unityHPC" / "metrics.json").read_text())
    except (OSError, json.JSONDecodeError):
        return None, "min"
    return data.get("primary"), data.get("goal", "min")


def _find(rows: list[dict], key: str, value: str) -> dict | None:
    return next((row for row in rows if row.get(key, "").startswith(value)), None)


def main(argv: list[str]) -> int:
    if len(argv) != 3:
        print("Usage: hpc-compare <row-a> <row-b>", file=sys.stderr)
        return 2
    project = Path(os.environ.get("HPC_PROJECT_DIR", os.getcwd()))
    path = project / "results.tsv"
    if not path.is_file():
        print(f"No results.tsv found in {project}", file=sys.stderr)
        return 1
    with path.open(newline="", encoding="utf-8") as fh:
        reader = csv.DictReader(fh, delimiter="\t", restkey="_extra")
        columns = reader.fieldnames or []
        rows = list(reader)
    if not columns:
        print("results.tsv is empty.", file=sys.stderr)
        return 1
    key = "commit" if "commit" in columns else columns[0]
    a, b = _find(rows, key, argv[1]), _find(rows, key, argv[2])
    print("=== Experiment Comparison ===\n")
    for label, requested, row in (("A", argv[1], a), ("B", argv[2], b)):
        if row is None:
            print(f"{label} ({requested}): not found in results.tsv")
            continue
        values = "  ".join(f"{column}={row.get(column, '')}" for column in columns)
        print(f"{label} ({requested}): {values}")

    primary, goal = _metrics(project)
    if a and b and primary in columns:
        try:
            before, after = float(a[primary]), float(b[primary])
        except (KeyError, TypeError, ValueError):
            pass
        else:
            delta = after - before
            improved = delta < 0 if goal == "min" else delta > 0
            verdict = "improvement" if improved else "regression"
            print(f"\n{primary} delta: {delta:+.6g} ({verdict}; goal={goal})")

    print(f"\n=== Git diff ({argv[1]} → {argv[2]}) ===")
    proc = subprocess.run(["git", "-C", str(project), "diff", argv[1], argv[2]], text=True)
    if proc.returncode:
        print("(git diff not available — not in a git repo or revisions not found)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
