#!/usr/bin/env python3
"""Decide whether sync-telemetry.sh may pass --delete.

Reads `rsync --dry-run --delete --itemize-changes` output on stdin.
Exit 0  -> safe to apply --delete.
Exit 10 -> withhold --delete (warnings on stderr).
UNITY_HPC_FORCE_PRUNE=1 forces exit 0.
"""

import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib import retention  # noqa: E402


def main() -> int:
    days = retention.parse_deletions(sys.stdin.read().splitlines())
    force = os.environ.get("UNITY_HPC_FORCE_PRUNE") == "1"
    allow, warnings = retention.retention_decision(days, force=force)
    for w in warnings:
        print(f"hpc-retention-gate: {w}", file=sys.stderr)
    return 0 if allow else 10


if __name__ == "__main__":
    raise SystemExit(main())
