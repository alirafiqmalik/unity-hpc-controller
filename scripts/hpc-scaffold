#!/usr/bin/env python3
"""Generate the unityHPC/ scaffold for a project.

Usage:
  hpc-scaffold --type {cpu,gpu,ml,multi-cpu,multi-gpu} [--project-dir DIR] [--dry-run]
  UNITY_HPC_NONINTERACTIVE=1 hpc-scaffold --type cpu --account ACCOUNT \
    --remote-dir /work/ACCOUNT/user/project --job-command 'python run.py'

Invoked by /unity-hpc:connect. Existing generated files that differ from the canonical
template are moved into unityHPC/.pre-redesign/ rather than being overwritten
in place; existing .env and project-owned sync/fetch adapters are preserved.
"""

import argparse
import getpass
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib import scaffold  # noqa: E402


_REQUIRED = ("SLURM_ACCOUNT", "REMOTE_DIR", "JOB_COMMAND")

#: .env keys this script can set from a flag, in the order they are reported
_CONFIGURABLE = ("SLURM_ACCOUNT", "REMOTE_DIR", "JOB_COMMAND", "UNITY_HOST",
                 "SLURM_CONSTRAINT", "VENV_PATH", "MODULES", "HF_HOME",
                 "REMOTE_RESULTS_DIR")


def _read_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    if not path.exists():
        return values
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        if not line or line.lstrip().startswith("#") or "=" not in line:
            continue
        key, raw = line.split("=", 1)
        key = key.strip()
        if not key or not key.replace("_", "").isalnum():
            continue
        try:
            tokens = shlex.split(raw, comments=True, posix=True)
        except ValueError:
            continue
        values[key] = " ".join(tokens) if tokens else ""
    return values


_ASSIGNMENT = re.compile(r"^(?P<indent>\s*)(?P<key>[A-Za-z_][A-Za-z0-9_]*)=(?P<rest>.*)$")


def _trailing_comment(rest: str) -> str:
    """The `# ...` tail of an assignment, honouring quotes.

    `TAG="build#1"` has no comment. Scanning for a bare `#` would eat the value,
    which is the same class of mistake that once carried a documentation comment
    into UNITY_HOST and made every remote call fail on the hostname."""
    quote = ""
    for i, ch in enumerate(rest):
        if quote:
            if ch == quote:
                quote = ""
        elif ch in "\"'":
            quote = ch
        elif ch == "#" and (i == 0 or rest[i - 1].isspace()):
            return rest[i:]
    return ""


def _configure_env(path: Path, values: dict[str, str]) -> None:
    """Set each key in the project .env, in place.

    Substitutes into the placeholder the template already ships, and appends
    only a key the file does not define. Appending unconditionally left six keys
    defined twice -- once blank from the template, once with the real value --
    which works when the file is sourced, because the last assignment wins, but
    reads as empty to anything that parses it, and is a trap to hand-edit.

    Every uncommented assignment of a key is rewritten, not just the last one,
    so a file already carrying duplicates from an earlier run ends up
    self-consistent instead of merely last-wins. Comments, ordering and
    alignment are preserved: this file is the user's to read."""
    if not path.exists():
        return
    remaining = dict(values)
    out: list[str] = []
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        match = _ASSIGNMENT.match(line)
        if match and match.group("key") in values:
            key = match.group("key")
            comment = _trailing_comment(match.group("rest"))
            assignment = f"{match.group('indent')}{key}={shlex.quote(values[key])}"
            if comment:
                column = len(line) - len(comment)
                assignment += " " * max(1, column - len(assignment)) + comment
            out.append(assignment)
            remaining.pop(key, None)
            continue
        out.append(line)

    if remaining:
        out += ["", "# --- added by hpc-scaffold ---"]
        out += [f"{key}={shlex.quote(value)}" for key, value in remaining.items()]
    path.write_text("\n".join(out) + "\n", encoding="utf-8")


def _write_guidance(project_dir: Path) -> bool:
    path = project_dir / "CLAUDE.md"
    if path.exists():
        return False
    source = scaffold.plugin_root() / "templates" / "CLAUDE.md.template"
    path.write_text(scaffold.render(source.read_text(encoding="utf-8")), encoding="utf-8")
    return True


#: `[ \t]*` rather than `\s*`, so substitution does not swallow the newline and
#: silently reflow the user's file on every refresh
_MARKER = re.compile(r"^<!--[ \t]*unity-hpc-guidance:[ \t]*[^\s>]+[ \t]*-->[ \t]*$", re.M)


def _refresh_guidance_marker(project_dir: Path) -> str:
    """Bring an existing CLAUDE.md's version marker up to date.

    unity_doctor reports `claude_guidance_stale` only when CLAUDE.md EXISTS
    without a current marker, and its suggested fix was --write-guidance, which
    only acts when the file is ABSENT. The advice could not resolve the finding
    it was attached to, so an agent following it looped.

    Only the marker line is touched. The prose is the user's, and
    --write-guidance keeps its promise never to overwrite it."""
    path = project_dir / "CLAUDE.md"
    marker = f"<!-- unity-hpc-guidance: {scaffold.plugin_version()} -->"
    if not path.exists():
        return "absent"
    text = path.read_text(encoding="utf-8", errors="replace")
    if _MARKER.search(text):
        updated = _MARKER.sub(marker, text, count=1)
        if updated == text:
            return "current"
        path.write_text(updated, encoding="utf-8")
        return "updated"
    separator = "" if text.endswith("\n") else "\n"
    path.write_text(f"{text}{separator}\n{marker}\n", encoding="utf-8")
    return "added"


def _deploy_collector(values: dict[str, str]) -> None:
    """Copy the sample scripts. Do not start a resident collector loop.

    The controller opens the tmux session when a schedule runs, and that
    session closes on its own. See ADR 0004.
    """
    host = values.get("UNITY_HOST") or "unity"
    account = values["SLURM_ACCOUNT"]
    cid = values.get("UNITY_CID") or f"/work/{account}/{getpass.getuser()}/cluster-intel"
    timeout = values.get("UNITY_SSH_TIMEOUT") or "60"
    quoted_cid = shlex.quote(cid)
    root = scaffold.plugin_root()
    subprocess.run(["timeout", "--foreground", timeout, "ssh", host,
                    f"mkdir -p -- {quoted_cid}/telemetry"], check=True)
    subprocess.run(["scp", str(root / "cluster-intel" / "collector.sh"),
                    str(root / "cluster-intel" / "collector_parse.py"),
                    f"{host}:{cid}/"], check=True)


def main() -> int:
    parser = argparse.ArgumentParser(prog="hpc-scaffold")
    parser.add_argument("--type", dest="ptype", required=True, choices=scaffold.TYPES)
    parser.add_argument("--project-dir", default=".")
    parser.add_argument("--dry-run", action="store_true",
                        help="print what would change and exit without writing")
    parser.add_argument("--non-interactive", action="store_true",
                        help="require complete explicit configuration; never prompt")
    parser.add_argument("--account", dest="SLURM_ACCOUNT")
    parser.add_argument("--remote-dir", dest="REMOTE_DIR")
    parser.add_argument("--job-command", dest="JOB_COMMAND")
    parser.add_argument("--host", dest="UNITY_HOST")
    parser.add_argument("--constraint", dest="SLURM_CONSTRAINT",
                        help="node feature, e.g. 'sm_80&vram48'; rendered as #SBATCH --constraint")
    # The job template reads all three, and shipping them blank put a GPU job on
    # the system python with no framework installed -- a failure the plugin
    # could not explain, because nothing had asked about the environment.
    parser.add_argument("--venv", dest="VENV_PATH",
                        help="virtualenv to activate on the node, e.g. /work/.../.venv")
    parser.add_argument("--modules", dest="MODULES",
                        help="modules to load on the node, e.g. 'cuda/12.8'")
    parser.add_argument("--hf-home", dest="HF_HOME",
                        help="HF_HOME for the job, e.g. /work/.../hf-cache")
    parser.add_argument("--results-dir", dest="REMOTE_RESULTS_DIR",
                        help="remote directory fetch pulls artifacts from")
    parser.add_argument("--collector", choices=("skip", "deploy"), default="skip",
                        help="collector action (default: skip; deploy is explicit)")
    parser.add_argument("--write-guidance", action="store_true",
                        help="create a version-marked CLAUDE.md only if it is absent")
    parser.add_argument("--refresh-guidance-marker", action="store_true",
                        help="update only the version marker in an existing CLAUDE.md")
    args = parser.parse_args()

    project_dir = Path(args.project_dir).expanduser().resolve()
    if not project_dir.is_dir():
        print(f"hpc-scaffold: not a directory: {project_dir}", file=sys.stderr)
        return 2

    try:
        actions = scaffold.plan(project_dir, args.ptype)
    except ValueError as exc:
        print(f"hpc-scaffold: {exc}", file=sys.stderr)
        return 2

    env_path = project_dir / "unityHPC" / ".env"
    existing = _read_env(env_path)
    supplied = {key: getattr(args, key) for key in _CONFIGURABLE
                if getattr(args, key) is not None}
    values = {**existing, **supplied}
    noninteractive = args.non_interactive or os.environ.get("UNITY_HPC_NONINTERACTIVE") == "1"
    if noninteractive or args.collector == "deploy":
        missing = [key for key in _REQUIRED if not values.get(key)]
        if missing:
            mode = "collector deployment" if args.collector == "deploy" and not noninteractive else "non-interactive setup"
            print(f"hpc-scaffold: {mode} requires " + ", ".join(missing) +
                  " (use flags or provide non-empty values in unityHPC/.env)", file=sys.stderr)
            return 2

    if args.dry_run:
        print(f"Would generate the {args.ptype} scaffold in {project_dir}/unityHPC:")
        for action in actions:
            print(f"  {action.kind:<8} unityHPC/{action.path.name}")
        if supplied:
            print("  configure unityHPC/.env: " + ", ".join(sorted(supplied)))
        if args.write_guidance:
            print("  create CLAUDE.md" if not (project_dir / "CLAUDE.md").exists()
                  else "  skip CLAUDE.md (already exists)")
        if args.refresh_guidance_marker:
            print("  refresh the version marker in CLAUDE.md"
                  if (project_dir / "CLAUDE.md").exists()
                  else "  skip marker refresh (no CLAUDE.md)")
        if args.collector == "deploy":
            print("  copy sample scripts (explicit request; no resident loop)")
        return 0

    print(f"Generating the {args.ptype} scaffold in {project_dir}/unityHPC:")
    for line in scaffold.apply(actions):
        print(line)

    if supplied:
        _configure_env(env_path, supplied)
        print("  configured unityHPC/.env: " + ", ".join(sorted(supplied)))
    if args.write_guidance:
        print("  created CLAUDE.md" if _write_guidance(project_dir)
              else "  skip     CLAUDE.md (already exists; "
                   "--refresh-guidance-marker updates its version marker)")
    if args.refresh_guidance_marker:
        print({
            "added": "  stamped  CLAUDE.md (version marker added)",
            "updated": "  stamped  CLAUDE.md (version marker updated)",
            "current": "  skip     CLAUDE.md (version marker already current)",
            "absent": "  skip     CLAUDE.md (no such file; use --write-guidance)",
        }[_refresh_guidance_marker(project_dir)])
    if args.collector == "deploy":
        _deploy_collector(values)
        print("  copied sample scripts (the controller opens the session)")

    if any(a.kind == "replace" for a in actions):
        print(f"\nDisplaced files are preserved in "
              f"unityHPC/{scaffold.BACKUP_DIRNAME}/ — review them if you had "
              f"local changes.")
    if noninteractive:
        print("\nNon-interactive scaffold complete.")
    else:
        print("\nNext: fill in SLURM_ACCOUNT, REMOTE_DIR and JOB_COMMAND in unityHPC/.env")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
