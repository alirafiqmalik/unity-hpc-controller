#!/usr/bin/env bash
# hpc-ssh [command] — SSH to Unity with env loaded
# No args: interactive shell. With args: run command on cluster.
set -euo pipefail

HPC_DIR="${HPC_PROJECT_DIR:-$PWD}"
ENV_FILE="$HPC_DIR/unityHPC/.env"

if [[ -f "$ENV_FILE" ]]; then
    set -a; source "$ENV_FILE"; set +a
fi

UNITY_HOST="${UNITY_HOST:-unity}"

if [[ $# -eq 0 ]]; then
    exec ssh "$UNITY_HOST"
else
    exec ssh "$UNITY_HOST" "$@"
fi
