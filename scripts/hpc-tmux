#!/usr/bin/env bash
# hpc-tmux <cmd> [args] — manage named tmux sessions on Unity via SSH
# Usage:
#   hpc-tmux ls                      list all sessions
#   hpc-tmux start <name> [command]  create a new detached session
#   hpc-tmux attach <name>           attach interactively
#   hpc-tmux kill <name>             kill a session
#   hpc-tmux send <name> <keys>      send keys to a session
set -euo pipefail

HPC_DIR="${HPC_PROJECT_DIR:-$PWD}"
ENV_FILE="$HPC_DIR/unityHPC/.env"
[[ -f "$ENV_FILE" ]] && set -a && source "$ENV_FILE" && set +a
UNITY_HOST="${UNITY_HOST:-unity}"

# The login node is shared: a wedged connection must not hang forever holding a
# session. Same knob the MCP server reads; lower default because every command
# here is instant. `attach` is deliberately exempt — it is an interactive session.
SSH=(timeout "${UNITY_SSH_TIMEOUT:-30}" ssh -o BatchMode=yes -o ConnectTimeout=10)

# Verbatim copy of _require_safe_name in templates/scaffold/common/run.sh, kept
# textually identical by tests/test_safe_name_parity.py. run.sh cannot source
# this file (it is copied into consumer projects and must survive a plugin move),
# and scripts/ is symlinked onto PATH wholesale, so a shared helper here would
# become a user-visible command. Two copies plus a parity test is the trade.
_require_safe_name() {
    local what="$1" value="$2"
    case "$value" in
        "")
            echo "hpc-tmux: $what must not be empty" >&2; exit 2 ;;
        *[!A-Za-z0-9._-]*)
            echo "hpc-tmux: invalid $what: '$value'" >&2
            echo "hpc-tmux:   use only letters, digits, '.', '_' or '-'. This name becomes" >&2
            echo "hpc-tmux:   a job name, a filename and part of a remote command." >&2
            exit 2 ;;
        -*|.*)
            echo "hpc-tmux: $what must not start with '-' or '.': '$value'" >&2; exit 2 ;;
    esac
    if [ "${#value}" -gt 64 ]; then
        echo "hpc-tmux: $what is too long (max 64 characters): '$value'" >&2; exit 2
    fi
}

CMD="${1:-ls}"
shift || true

case "$CMD" in
    ls|list)
        echo "tmux sessions on $UNITY_HOST:"
        "${SSH[@]}" "$UNITY_HOST" "tmux ls 2>/dev/null || echo '  (no sessions)'"
        ;;
    start|new)
        NAME="${1:?Usage: hpc-tmux start <name> [command]}"
        SESS_CMD="${2:-bash}"
        _require_safe_name "session name" "$NAME"
        # ssh takes one remote command string, so quote each value for the remote
        # shell. The command stays intentionally arbitrary; the name does not.
        printf -v QNAME '%q' "$NAME"
        printf -v QCMD '%q' "$SESS_CMD"
        # One round trip, not two: the login node is shared, and a probe followed
        # by a create costs two full handshakes. The token tells us which ran.
        RESULT="$("${SSH[@]}" "$UNITY_HOST" \
            "tmux has-session -t $QNAME 2>/dev/null && echo exists \
             || { tmux new-session -d -s $QNAME $QCMD && echo started; }")"
        case "$RESULT" in
            exists)  echo "Session '$NAME' already exists on $UNITY_HOST" ;;
            started) echo "Started session '$NAME' on $UNITY_HOST" ;;
            *)       echo "hpc-tmux: unexpected reply from $UNITY_HOST: '$RESULT'" >&2
                     exit 1 ;;
        esac
        ;;
    attach)
        NAME="${1:?Usage: hpc-tmux attach <name>}"
        _require_safe_name "session name" "$NAME"
        printf -v QNAME '%q' "$NAME"
        ssh -t "$UNITY_HOST" "tmux attach-session -t $QNAME"
        ;;
    kill)
        NAME="${1:?Usage: hpc-tmux kill <name>}"
        _require_safe_name "session name" "$NAME"
        printf -v QNAME '%q' "$NAME"
        "${SSH[@]}" "$UNITY_HOST" "tmux kill-session -t $QNAME"
        echo "Killed session '$NAME' on $UNITY_HOST"
        ;;
    send)
        NAME="${1:?Usage: hpc-tmux send <name> <keys>}"
        KEYS="${2:?provide keys to send}"
        _require_safe_name "session name" "$NAME"
        printf -v QNAME '%q' "$NAME"
        printf -v QKEYS '%q' "$KEYS"
        "${SSH[@]}" "$UNITY_HOST" "tmux send-keys -t $QNAME $QKEYS Enter"
        ;;
    *)
        echo "Usage: hpc-tmux ls | start <name> [cmd] | attach <name> | kill <name> | send <name> <keys>" >&2
        exit 1
        ;;
esac
