# unityHPC/.env — generated by /unity-hpc:setup (project type: ml).
# Safe to hand-edit: setup preserves this file once you have customised it.

# ── required ─────────────────────────────────────────────────────────────────
SLURM_ACCOUNT=""                 # e.g. pi_yourlab_umass_edu
REMOTE_DIR=""                    # e.g. /work/pi_yourlab_umass_edu/you/myproject
JOB_COMMAND=""                   # for multi-node this is the script torchrun runs,
                                 # e.g. "train.py --config base"

# ── optional ─────────────────────────────────────────────────────────────────
USER_EMAIL=""
UNITY_HOST="unity"
VENV_PATH=""
MODULES=""                       # e.g. "cuda/12.8"
HF_HOME=""                       # optional shared HuggingFace cache

# ── resources (training; raise SLURM_NODES for multi-node torchrun) ──────────
SLURM_PARTITION="gpu"
WALLTIME="08:00:00"
SLURM_CPUS="8"
SLURM_MEM="64G"
SLURM_NODES="1"
SLURM_GPUS="1"
SLURM_GPU_TYPE=""
SLURM_CONSTRAINT=""               # optional node feature, e.g. nvlink
UNITY_TELEMETRY_SRC=""            # optional host:/.../telemetry/ source for local sync
