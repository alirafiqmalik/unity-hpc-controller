# unityHPC/.env — generated by /unity-hpc:setup (project type: gpu).
# Safe to hand-edit: setup preserves this file once you have customised it.

# ── required ─────────────────────────────────────────────────────────────────
SLURM_ACCOUNT=""                 # e.g. pi_yourlab_umass_edu
REMOTE_DIR=""                    # e.g. /work/pi_yourlab_umass_edu/you/myproject
JOB_COMMAND=""                   # the command your job runs, e.g. "python infer.py"

# ── optional ─────────────────────────────────────────────────────────────────
USER_EMAIL=""
UNITY_HOST="unity"
VENV_PATH=""                     # activated if set, e.g. "$REMOTE_DIR/.venv"
MODULES=""                       # e.g. "cuda/12.8" — blank loads nothing

# ── resources (single-node GPU) ──────────────────────────────────────────────
SLURM_PARTITION="gpu"
WALLTIME="04:00:00"
SLURM_CPUS="8"
SLURM_MEM="32G"
SLURM_NODES="1"
SLURM_GPUS="1"
SLURM_GPU_TYPE=""                # e.g. a100, l40s — blank = scheduler picks
