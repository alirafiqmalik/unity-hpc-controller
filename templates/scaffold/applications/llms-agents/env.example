# unityHPC/.env — generated by /unity-hpc:setup (application: llms-agents).
# Safe to hand-edit: setup preserves this file once you have customised it.
# UNITY_SCAFFOLD_VERSION=@@UNITY_HPC_VERSION@@

# ── required ─────────────────────────────────────────────────────────────────
SLURM_ACCOUNT=""                 # e.g. pi_yourlab_umass_edu
REMOTE_DIR=""                    # absolute project dir on the cluster /work share
JOB_COMMAND=""                   # stage runner sets this per stage

# ── optional ─────────────────────────────────────────────────────────────────
USER_EMAIL=""
UNITY_HOST="unity"
VENV_PATH=""
MODULES=""                       # e.g. "cuda/12.8"
HF_HOME=""                       # shared Hugging Face cache on REMOTE_DIR (NFS /work)
REMOTE_RESULTS_DIR=""            # artifacts base; blank = $REMOTE_DIR/_results.
                                 # The job gets $RESULTS_DIR=<base>/<campaign>.
                                 # fetch prefers that directory when the job created it.

# ── resources (defaults; a workflow stage overrides these for one run.sh) ───
SLURM_PARTITION="gpu"
WALLTIME="08:00:00"
SLURM_CPUS="8"
SLURM_MEM="64G"
SLURM_NODES="1"
SLURM_GPUS="1"
SLURM_GPU_TYPE=""
SLURM_CONSTRAINT=""
SLURM_PARTITION_FALLBACK=""
SLURM_PARTITION_WALLTIME_CAP=""
UNITY_TELEMETRY_SRC=""

# ── llms-agents ──────────────────────────────────────────────────────────────
LLMS_LAUNCHER="axolotl"         # axolotl or trl
LLMS_PARALLEL="fsdp"            # fsdp (default) or deepspeed
LLMS_DISTRIBUTED="torchrun"     # torchrun, or accelerate (exports WORLD_SIZE and RANK)
LLMS_OBJECTIVE="sft"            # sft or dpo
LLMS_EVAL_KIND="lm-eval"        # lm-eval or project
LLMS_ENGINE="openai"            # openai server, or project (in-process vLLM argv)
LLMS_MASTER_PORT="29500"
LLMS_CACHE_DIR=""               # blank = $REMOTE_DIR/_cache/llms-agents
LLMS_CHECKPOINT_DIR=""          # blank = $RESULTS_DIR/checkpoint-final
LLMS_EVAL_TASKS=""              # comma-separated lm-eval task names
LLMS_PROJECT_EVAL_ARGV=""       # used when LLMS_EVAL_KIND=project
LLMS_METRIC_KEYS="accuracy"     # comma-separated flat metric keys
LLMS_JOB="train"                # train, eval, or command
LLMS_STAGE="train"              # train or consolidate
