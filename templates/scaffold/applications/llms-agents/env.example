# unityHPC/.env — generated by /unity-hpc:connect (application: llms-agents).
# Safe to hand-edit: connect preserves this file once you have customised it.

# ── required ─────────────────────────────────────────────────────────────────
SLURM_ACCOUNT=""                 # e.g. pi_yourlab_umass_edu
REMOTE_DIR=""                    # e.g. /work/pi_yourlab_umass_edu/you/myproject
# The job: evaluate one dataset with one model. $EXP is the run name run.sh
# was given; the dashboard launches through unityHPC/project.json instead.
JOB_COMMAND='python3 unityHPC/evaluate.py run --dataset example --model Qwen/Qwen3-1.7B --out evaluations/$EXP --name $EXP'

# ── model endpoint ───────────────────────────────────────────────────────────
# agent.py talks to an OpenAI-compatible endpoint. On a compute node start
# `vllm serve <model>` in unityHPC/bootstrap.sh and point this at it.
LLM_BASE_URL="http://127.0.0.1:8000/v1"
LLM_API_KEY=""
LLM_TIMEOUT_S="600"

# ── optional ─────────────────────────────────────────────────────────────────
USER_EMAIL=""
UNITY_HOST="unity"
VENV_PATH=""                     # activated if set, e.g. "$REMOTE_DIR/.venv"
MODULES=""                       # e.g. "cuda/12.8" — blank loads nothing
HF_HOME=""                       # optional shared HuggingFace cache
REMOTE_RESULTS_DIR=""            # artifacts base; blank = $REMOTE_DIR/_results

# ── resources (single-node GPU) ──────────────────────────────────────────────
SLURM_PARTITION="gpu"
WALLTIME="02:00:00"
SLURM_CPUS="8"
SLURM_MEM="32G"
SLURM_NODES="1"
SLURM_GPUS="1"
SLURM_GPU_TYPE=""                # e.g. a100, l40s — blank = scheduler picks
SLURM_CONSTRAINT=""
SLURM_PARTITION_FALLBACK="gpu-preempt"
SLURM_PARTITION_WALLTIME_CAP=""
UNITY_TELEMETRY_SRC=""
