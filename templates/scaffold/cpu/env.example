# unityHPC/.env — generated by /unity-hpc:setup (project type: cpu).
# Safe to hand-edit: setup preserves this file once you have customised it.

# ── required ─────────────────────────────────────────────────────────────────
SLURM_ACCOUNT=""                 # e.g. pi_yourlab_umass_edu
REMOTE_DIR=""                    # e.g. /work/pi_yourlab_umass_edu/you/myproject
JOB_COMMAND=""                   # the command your job runs, e.g. "python pipeline.py"

# ── optional ─────────────────────────────────────────────────────────────────
USER_EMAIL=""                    # blank = no SLURM mail
UNITY_HOST="unity"               # ssh alias
VENV_PATH=""                     # activated if set, e.g. "$REMOTE_DIR/.venv"
MODULES=""                       # e.g. "gcc/13" — blank loads nothing

# ── resources (CPU-only defaults; long pipelines, no GPU) ────────────────────
SLURM_PARTITION="cpu"
WALLTIME="04:00:00"
SLURM_CPUS="8"
SLURM_MEM="16G"
SLURM_NODES="1"
SLURM_GPUS=""                    # blank = no GPU requested
SLURM_GPU_TYPE=""
SLURM_CONSTRAINT=""               # optional node feature, e.g. avx512
UNITY_TELEMETRY_SRC=""            # optional host:/.../telemetry/ source for local sync
