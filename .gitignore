# Python caches. These were tracked once, which made
# test_release_tree_has_no_tracked_cache_files fail on every test run.
__pycache__/
*.py[cod]

# pytest / coverage scratch
.pytest_cache/
.coverage

# Local environment files are never shipped.
.env

# Maintainer research notes and raw probe dumps stay local.
.research_notes/

# Local development environment and generated campaign settings.
.venv/
backend.json
