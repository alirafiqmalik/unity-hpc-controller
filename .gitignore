# Python caches. These were tracked once, which made
# test_release_tree_has_no_tracked_cache_files fail on every test run.
__pycache__/
*.py[cod]

# pytest / coverage scratch
.pytest_cache/
.coverage

# Local agent guidance. Machine-local, not shipped with the plugin.
/AGENTS.md

# Generated project config. The scaffold writes unityHPC/.env with a real
# SLURM_ACCOUNT and remote paths; a scratch project scaffolded inside this repo
# would otherwise be committable. The tracked templates are named env.example,
# which this pattern does not match.
.env
